#!/usr/bin/env bash
# Sign a dev binary with the "Satchel Mail Dev" certificate, then run it.
# scripts/run uses this as Cargo's runner for `tauri dev`, so each rebuild keeps
# the same code identity and the keychain's "Always Allow" still applies.
#
#   scripts/dev-sign BINARY [ARGS...]
#
# With no certificate (see scripts/dev-signing-cert) it just runs the binary.

set -euo pipefail

bin="$1"
if [[ "$(uname)" == Darwin ]] && security find-identity -v -p codesigning | grep -q '"Satchel Mail Dev"'; then
  codesign --force --sign "Satchel Mail Dev" --identifier "app.satchel.dev.$(basename "$bin")" "$bin"
fi
exec "$@"
