#!/usr/bin/env bash
# Build and run Satchel Mail.
#
#   scripts/run                  desktop app (Tauri dev, UI hot reload) on your real data
#   scripts/run web              web UI + API on http://127.0.0.1:7781
#   scripts/run dev              web UI with hot reload on http://localhost:7780
#   scripts/run [mode] --test    use the local Stalwart test servers and .dev/test-data
#   scripts/run [mode] --data DIR use DIR as the data directory (keychain secrets)
#
# Real data lives in the default data directory with secrets in the OS
# keychain. Run scripts/dev-signing-cert once so dev builds are signed with a
# stable certificate and the keychain's "Always Allow" survives rebuilds.
# OAuth client ids for Gmail / Microsoft (see docs/OAUTH.md) are read
# from .env in the repo root if it exists, e.g.
#
#   SATCHEL_GOOGLE_CLIENT_ID=...
#   SATCHEL_GOOGLE_CLIENT_SECRET=...
#   SATCHEL_MS_CLIENT_ID=...

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

mode=desktop
test=0
data=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    desktop|web|dev) mode="$1" ;;
    --test) test=1 ;;
    --data) data="${2:?--data needs a directory}"; shift ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1 (see scripts/run --help)" >&2; exit 1 ;;
  esac
  shift
done

if [[ -f .env ]]; then
  set -a; source .env; set +a
fi

# Never let a leftover test environment point the app at the wrong data.
unset SATCHEL_DATA_DIR SATCHEL_SECRETS
if (( test )); then
  export SATCHEL_DATA_DIR="$ROOT/.dev/test-data" SATCHEL_SECRETS=file
  if [[ "$(scripts/dev-servers status)" != running* ]]; then
    scripts/dev-servers start
  fi
elif [[ -n "$data" ]]; then
  mkdir -p "$data"
  export SATCHEL_DATA_DIR="$(cd "$data" && pwd)"
fi
echo "Data directory: ${SATCHEL_DATA_DIR:-default}"

cargo build --bin satchel
[[ -d ui/node_modules ]] || (cd ui && npm ci)

case "$mode" in
  web)
    (cd ui && npm run build)
    exec scripts/dev-sign target/debug/satchel serve --ui ui/dist
    ;;
  dev)
    # Vite serves the UI and proxies /api to `satchel serve`, sending the
    # shared session token as a bearer header.
    export SATCHEL_SESSION_TOKEN="${SATCHEL_SESSION_TOKEN:-$(openssl rand -hex 16)}"
    export SATCHEL_DEV_ORIGIN=http://localhost:7780
    scripts/dev-sign target/debug/satchel serve &
    server=$!
    trap 'kill $server 2>/dev/null' EXIT INT TERM
    # Opening the store takes a moment; don't let the page load before the API is up.
    for _ in $(seq 100); do
      curl -s -o /dev/null http://127.0.0.1:7781/ && break
      kill -0 $server 2>/dev/null || exit 1
      sleep 0.2
    done
    cd ui
    npm run dev
    ;;
  desktop)
    # Tauri runs the CLI as a sidecar named for the host triple.
    triple="$(rustc -vV | sed -n 's/host: //p')"
    cp target/debug/satchel "apps/desktop/binaries/satchel-$triple"
    # Cargo runs the app through dev-sign, so every rebuild is signed the same way.
    export "CARGO_TARGET_$(tr 'a-z-' 'A-Z_' <<<"$triple")_RUNNER=$ROOT/scripts/dev-sign"
    cd apps/desktop
    exec ../../ui/node_modules/.bin/tauri dev
    ;;
esac
